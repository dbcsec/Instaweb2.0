{
  "version": 2,
  "name": "instaweb-brand",
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" },
    { "src": "/find-leads", "dest": "/find-leads.html" },
    { "src": "/build-demo", "dest": "/build-demo.html" },
    { "src": "/outreach", "dest": "/outreach.html" },
    { "src": "/quick-fix", "dest": "/quick-fix.html" },
    { "src": "/data", "dest": "/data.html" },
    { "src": "/demo/(.*)", "dest": "/data/demos/mass_output/$1.html" },
    { "src": "/partners", "dest": "/agency-partners.html" },
    { "src": "/agency-partners", "dest": "/agency-partners.html" }
  ],
  "functions": {
    "api/stats.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
